<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wallet</groupId>
        <artifactId>wallet</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wallet-common</artifactId>

    <name>wallet-common</name>
    <description>通用件：统一返回体、业务异常与错误码、单号生成、分布式锁（Redisson）、金额工具。</description>

    <dependencies>
        <dependency>
            <!-- MDC：ApiResult 自动携带 traceId -->
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <!-- 仅注解包：ApiResult 的派生字段 success -->
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <!-- Jackson 序列化（pay/channel 共用：渠道配置 JSON 解析、回调报文解析），统一在 common -->
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <!-- Swagger @Schema 注解（仅注解包，统一在 common 提供，account/pay 传递获得） -->
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>

        <!-- ===== 横切基建依赖（类型/注解，可能多模块用）统一在 common 声明，下游经传递免重复 =====
             （lombok/junit 因作用域不传递，已上提到父 pom 的 <dependencies> 统一继承） -->
        <dependency>
            <!-- MP 核心：BaseMapper / LambdaWrapper / 注解（boot starter 只在 wallet-app 装配层） -->
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
        </dependency>
        <dependency>
            <!-- @Service/@Component/事件发布 -->
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <!-- @Transactional -->
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <!-- @ConfigurationProperties -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <!-- @Lock4j 注解类型：分布式锁是横切关注点，库模块经 common 获得注解；自动装配由 app 引 starter -->
            <groupId>com.baomidou</groupId>
            <artifactId>lock4j-core</artifactId>
        </dependency>
        <dependency>
            <!-- Redisson 分布式原语（RBucket/RAtomicLong/RRateLimiter…）：横切基建，可能多模块用 -->
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>
        <dependency>
            <!-- @ConditionalOnProperty 等条件装配注解：横切基建，可能多模块用 -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <!-- BCrypt 等加密工具：横切基建（如支付密码），可能多模块用 -->
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <!-- @XxlJob 定时任务注解：横切基建，可能多模块用（执行器在 wallet-app 装配） -->
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>

    </dependencies>
</project>
