<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wallet</groupId>
        <artifactId>wallet</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wallet-common</artifactId>

    <name>wallet-common</name>
    <description>通用件：统一返回体、业务异常与错误码、单号生成、分布式锁（Redisson）、金额工具。</description>

    <dependencies>
        <dependency>
            <!-- MDC：ApiResult 自动携带 traceId -->
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <!-- 仅注解包：ApiResult 的派生字段 success -->
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <!-- Swagger @Schema 注解（仅注解包，统一在 common 提供，asset/pay 传递获得） -->
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>

        <!-- ===== 以下为业务模块（asset/pay/channel）共用的基础运行时依赖，统一在 common 声明，下游免重复 =====
             （lombok/junit 因作用域不传递，已上提到父 pom 的 <dependencies> 统一继承） -->
        <dependency>
            <!-- MP 核心：BaseMapper / LambdaWrapper / 注解（boot starter 只在 wallet-app 装配层） -->
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
        </dependency>
        <dependency>
            <!-- @Service/@Component/事件发布 -->
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <!-- @Transactional -->
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <!-- @ConfigurationProperties -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>

    </dependencies>
</project>
