<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wallet</groupId>
        <artifactId>wallet</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wallet-asset</artifactId>

    <name>wallet-asset</name>
    <description>用户资产：余额 money、积分 point、优惠券 coupon、支付密码 password。
        扣减一律条件更新（CAS），流水按业务号幂等；支付密码 = BCrypt + 错误锁定 + 一次性票据。</description>

    <dependencies>
        <dependency>
            <groupId>com.wallet</groupId>
            <artifactId>wallet-common</artifactId>
        </dependency>
        <dependency>
            <!-- 库模块只依赖 MP 核心（BaseMapper/Wrapper/注解），boot starter 只在 wallet-app -->
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
        </dependency>
        <dependency>
            <!-- @Service/@Component -->
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <!-- @Transactional -->
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <!-- @ConfigurationProperties -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <!-- 支付密码票据/计数：RBucket/RAtomicLong -->
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>
        <dependency>
            <!-- 只为 BCrypt，不引入完整 Spring Security -->
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
