<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.wallet</groupId>
    <artifactId>wallet</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>wallet</name>
    <description>钱包工程：用户资产（余额/积分/优惠券/支付密码）+ 三方支付内核 + 拆分支付编排。
        由 pay-channel-sdk 扩展而来，同一支付单的所有状态变更共用一把分布式锁。</description>

    <modules>
        <module>wallet-common</module>
        <module>wallet-channel</module>
        <module>wallet-asset</module>
        <module>wallet-pay</module>
        <module>wallet-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <lombok.version>1.18.42</lombok.version>
        <lock4j.version>2.2.7</lock4j.version>
        <xxl-job.version>3.4.2</xxl-job.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <redisson.version>4.7.0</redisson.version>
        <!-- springdoc 2.8.x = OpenAPI 3 / Swagger 3（适配 Boot 3.5） -->
        <springdoc.version>2.8.17</springdoc.version>
        <!-- 与 springdoc 2.8.17 传递版本一致，供库模块给 DTO/实体标 @Schema -->
        <swagger-annotations.version>2.2.52</swagger-annotations.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 官方 BOM：slf4j / jackson2 / junit5 / mysql 驱动等版本都由它管 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud BOM（2025.0.x 对应 Boot 3.5）：目前只做版本管理，组件按需引入 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.wallet</groupId>
                <artifactId>wallet-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wallet</groupId>
                <artifactId>wallet-channel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wallet</groupId>
                <artifactId>wallet-asset</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wallet</groupId>
                <artifactId>wallet-pay</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 三方组件（Boot BOM 没管的） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <!-- 库模块（asset/pay）编译用：BaseMapper/Wrapper/注解，不带 Boot 自动装配 -->
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <!-- 3.5.9+ 分页插件（PaginationInnerInterceptor）拆到了独立模块 -->
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <!-- 只用核心包不用 starter，手动装配 RedissonClient -->
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <!-- Spring Data Redis ⇄ Redisson 桥接（-35 对应 Spring Data Redis 3.5.x/Boot 3.5.x），
                     提供 RedissonConnectionFactory，让 RedisTemplate 底层走 Redisson -->
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-data-35</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <!-- 仅注解包（jakarta 版）：@Schema/@Tag/@Operation -->
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger-annotations.version}</version>
            </dependency>
            <dependency>
                <!-- 显式钉版本（不走 Boot BOM）：JDK 21 需要 1.18.42+ -->
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <!-- XXL-Job 分布式定时任务：执行器嵌在 wallet-app，需另行部署 xxl-job-admin 调度中心。
                     groovy 只有 GLUE 脚本模式用，本工程全走 BEAN 模式，排除瘦身 -->
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <!-- Antom（支付宝国际）官方 SDK，版本统一在父 pom 管理 -->
                <groupId>com.alipay.global.sdk</groupId>
                <artifactId>global-open-sdk-java</artifactId>
                <version>2.0.70</version>
            </dependency>
            <dependency>
                <!-- @Lock4j 声明式分布式锁（2.2.7 官方支持 Boot 3）。
                     其 redisson-spring-boot-starter 依赖是 provided 不会传递，
                     RedissonLockExecutor 复用 RedisConfig 手动装配的 RedissonClient -->
                <groupId>com.baomidou</groupId>
                <artifactId>lock4j-redisson-spring-boot-starter</artifactId>
                <version>${lock4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 全模块共用的基础依赖。lombok(provided) 与 junit-jupiter(test) 作用域不具传递性，
         无法放进 wallet-common 让下游继承，因此直接声明在父 pom，所有子模块自动继承，
         各模块不再各自声明。（版本由上方 dependencyManagement / Boot BOM 管理） -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>UTF-8</encoding>
                        <!-- Spring MVC 需要参数名做 @PathVariable/@RequestParam 解析 -->
                        <parameters>true</parameters>
                        <!-- JDK 23+ 默认 -proc:none，必须显式声明处理器 Lombok 才生效 -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
